{
  "name": "base-htmx",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.tsx",
    "build:client": "esbuild src/client/scripts/index.ts --bundle --minify --outfile=public/js/app.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:css": "tailwindcss -i ./src/client/styles/index.css -o ./public/css/output.css",
    "watch:css": "tailwindcss -i ./src/client/styles/index.css -o ./public/css/output.css --watch",
    "email": "email dev"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.114",
    "@aws-sdk/client-bedrock-runtime": "^3.1066.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/postgres": "^6.0.2",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "@kitajs/fastify-html-plugin": "^4.1.0",
    "@kitajs/html": "^4.2.0",
    "@libsql/client": "^0.17.3",
    "@react-email/render": "^2.0.8",
    "@tailwindcss/cli": "^4.3.0",
    "argon": "^2.0.21",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.10.0",
    "classnames": "^2.5.1",
    "connect-pg-simple": "^10.0.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-beta.22",
    "fastify": "^5.3.0",
    "fastify-type-provider-zod": "^6.1.0",
    "htmx.org": "=2.0.6",
    "nodemailer": "^8.0.10",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "1.0.0-beta.22",
    "esbuild": "^0.28.0",
    "react-email": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
